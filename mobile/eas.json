{
  "cli": {
    "version": ">= 18.0.6",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_BACKEND_URL": "https://intellifit.net",
        "EXPO_PUBLIC_PRIVACY_POLICY_URL": "https://intellifit.net/legal/privacy",
        "EXPO_PUBLIC_TERMS_OF_USE_URL": "https://www.apple.com/legal/internet-services/itunes/dev/stdeula/"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
