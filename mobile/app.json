{
  "expo": {
    "name": "IntelliFit",
    "description": "AI Integrated Fitness Tracker",
    "slug": "mobile",
    "scheme": "gymtracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Allow IntelliFit to take food photos for nutrition analysis.",
        "NSPhotoLibraryUsageDescription": "Allow IntelliFit to select food photos for nutrition analysis.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.lesliejiang.gymtracker"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "53aedda8-1f83-4a57-b561-7282347bd7fe"
      }
    }
  }
}
