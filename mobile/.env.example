EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Full URL including scheme (e.g. https://api.example.com). Bare hostnames like example.com are auto-prefixed with https://
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_your_revenuecat_ios_public_sdk_key
# Must match RevenueCat Product catalog → Entitlements → Identifier (not REST API id entl…)
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=IntelliFit Pro
# Production: https://intellifit.net (also set in eas.json production profile)
# Optional overrides. Defaults: {EXPO_PUBLIC_BACKEND_URL}/legal/privacy and Apple's standard EULA.
EXPO_PUBLIC_PRIVACY_POLICY_URL=https://intellifit.net/legal/privacy
EXPO_PUBLIC_TERMS_OF_USE_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
