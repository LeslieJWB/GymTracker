NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gymtracker
LLM_PROVIDER=kimi
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k2.5
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=gemini-2.5-flash
VERTEX_API_KEY=your_vertex_api_key_here
VERTEX_BASE_URL=https://aiplatform.googleapis.com/v1/publishers/google/models
VERTEX_MODEL=gemini-2.5-flash-lite
VERTEX_THINKING_LEVEL=low
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Service role key (Project Settings → API → service_role). Required for account deletion.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
FREE_LLM_CALLS_PER_DAY=5
SUBSCRIBER_LLM_CALLS_PER_DAY=30
LLM_UNLIMITED_SUPABASE_USER_IDS=
REVENUECAT_WEBHOOK_AUTH_TOKEN=your_revenuecat_webhook_auth_token
# Secret API key (Project Settings → API keys → Secret). Used to sync subscriptions when webhooks cannot reach the server (e.g. local dev).
REVENUECAT_SECRET_API_KEY=sk_your_revenuecat_secret_api_key
# Must match RevenueCat entitlement Identifier and EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID
REVENUECAT_ENTITLEMENT_ID=IntelliFit Pro
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
TRUST_PROXY=false
